class StripePaymentIntent(
    val id: string,
    val status: string,
    val amount: int,
    val amountCapturable: int,
    val amountReceived: int,
    val currency: string,
    val customerId: string,
    val paymentMethodId: string,
    val latestChargeId: string,
    val captureMethod: string,
    // Hand this to the browser for the one customer paying; don't log or store it.
    val clientSecret: string,
    val description: string,
    val receiptEmail: string,
    val cancellationReason: string,
    val canceledAt: int,
    val created: int,
    val livemode: bool,
    val metadata: Json,
    val raw: Json
)

fun stripePaymentIntent(value: Json): StripePaymentIntent = StripePaymentIntent(
    value.getString("id"), value.getString("status"), value.getInt("amount"),
    value.getInt("amount_capturable"), value.getInt("amount_received"),
    value.getString("currency"), stripeExpandableId(value.get("customer")),
    stripeExpandableId(value.get("payment_method")),
    stripeExpandableId(value.get("latest_charge")),
    value.getString("capture_method"), value.getString("client_secret"),
    value.getString("description"), value.getString("receipt_email"),
    value.getString("cancellation_reason"), value.getInt("canceled_at"),
    value.getInt("created"), value.get("livemode").asBoolean(),
    stripeJsonStringMap(value.get("metadata")), value
)

