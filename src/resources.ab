class StripeFee(
    val amount: int,
    val currency: string,
    val feeType: string,
    val description: string,
    val application: string,
    val raw: Json
)

fun stripeFee(value: Json): StripeFee = StripeFee(
    value.getInt("amount"), value.getString("currency"), value.getString("type"),
    value.getString("description"), value.getString("application"), value
)

class StripeBalanceTransaction(
    val id: string,
    val transactionType: string,
    val status: string,
    val reportingCategory: string,
    val balanceType: string,
    val amount: int,
    val fee: int,
    val net: int,
    val currency: string,
    // The number exactly as Stripe wrote it, or "" when there is none.
    val exchangeRate: string,
    val feeDetails: array<StripeFee>,
    val sourceId: string,
    val description: string,
    val availableOn: int,
    val created: int,
    val raw: Json
)

fun stripeBalanceTransaction(value: Json): StripeBalanceTransaction {
    val fees: array<StripeFee> = []
    val source = value.get("fee_details")
    var index = 0
    while (source.isArray() && index < source.size()) {
        fees.append(stripeFee(source.at(index)))
        index = index + 1
    }
    return StripeBalanceTransaction(
        value.getString("id"), value.getString("type"), value.getString("status"),
        value.getString("reporting_category"), value.getString("balance_type"),
        value.getInt("amount"), value.getInt("fee"), value.getInt("net"),
        value.getString("currency"), value.get("exchange_rate").asNumber().text,
        fees, stripeExpandableId(value.get("source")),
        value.getString("description"), value.getInt("available_on"),
        value.getInt("created"), value
    )
}

class StripeDispute(
    val id: string,
    val status: string,
    val reason: string,
    val amount: int,
    val currency: string,
    val chargeId: string,
    val paymentIntentId: string,
    val isChargeRefundable: bool,
    val evidenceDueBy: int,
    val hasEvidence: bool,
    val pastDue: bool,
    val submissionCount: int,
    val balanceTransactions: array<StripeBalanceTransaction>,
    val created: int,
    val livemode: bool,
    val metadata: Json,
    val raw: Json
)

fun stripeDispute(value: Json): StripeDispute {
    val details = value.get("evidence_details")
    val transactions: array<StripeBalanceTransaction> = []
    val source = value.get("balance_transactions")
    var index = 0
    while (source.isArray() && index < source.size()) {
        transactions.append(stripeBalanceTransaction(source.at(index)))
        index = index + 1
    }
    return StripeDispute(
        value.getString("id"), value.getString("status"), value.getString("reason"),
        value.getInt("amount"), value.getString("currency"),
        stripeExpandableId(value.get("charge")),
        stripeExpandableId(value.get("payment_intent")),
        value.get("is_charge_refundable").asBoolean(), details.getInt("due_by"),
        details.get("has_evidence").asBoolean(),
        details.get("past_due").asBoolean(), details.getInt("submission_count"),
        transactions, value.getInt("created"), value.get("livemode").asBoolean(),
        stripeJsonStringMap(value.get("metadata")), value
    )
}

class StripePayout(
    val id: string,
    val status: string,
    val payoutType: string,
    val method: string,
    val sourceType: string,
    val amount: int,
    val currency: string,
    val arrivalDate: int,
    val automatic: bool,
    val destinationId: string,
    val balanceTransactionId: string,
    val failureBalanceTransactionId: string,
    val failureCode: string,
    val failureMessage: string,
    val originalPayoutId: string,
    val reversedById: string,
    val reconciliationStatus: string,
    val statementDescriptor: string,
    val description: string,
    val created: int,
    val livemode: bool,
    val metadata: Json,
    val raw: Json
)

fun stripePayout(value: Json): StripePayout = StripePayout(
    value.getString("id"), value.getString("status"), value.getString("type"),
    value.getString("method"), value.getString("source_type"),
    value.getInt("amount"), value.getString("currency"),
    value.getInt("arrival_date"), value.get("automatic").asBoolean(),
    stripeExpandableId(value.get("destination")),
    stripeExpandableId(value.get("balance_transaction")),
    stripeExpandableId(value.get("failure_balance_transaction")),
    value.getString("failure_code"), value.getString("failure_message"),
    stripeExpandableId(value.get("original_payout")),
    stripeExpandableId(value.get("reversed_by")),
    value.getString("reconciliation_status"),
    value.getString("statement_descriptor"), value.getString("description"),
    value.getInt("created"), value.get("livemode").asBoolean(),
    stripeJsonStringMap(value.get("metadata")), value
)

class StripeList(
    val data: array<Json>,
    val hasMore: bool,
    val url: string,
    val raw: Json
)

fun stripeList(value: Json): StripeList {
    val data: array<Json> = []
    val source = value.get("data")
    var index = 0
    while (source.isArray() && index < source.size()) {
        data.append(source.at(index))
        index = index + 1
    }
    StripeList(data, value.get("has_more").asBoolean(), value.getString("url"), value)
}
