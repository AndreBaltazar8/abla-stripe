    val paid: bool,
    val refunded: bool,
    val disputed: bool,
    val customerId: string,
    val paymentIntentId: string,
    val paymentMethodId: string,
    val balanceTransactionId: string,
    val description: string,
    val failureCode: string,
    val failureMessage: string,
    val receiptUrl: string,
    val created: int,
    val livemode: bool,
    val metadata: Json,
    val raw: Json
)

fun stripeCharge(value: Json): StripeCharge = StripeCharge(
    value.getString("id"), value.getString("status"), value.getInt("amount"),
    value.getInt("amount_captured"), value.getInt("amount_refunded"),
    value.getString("currency"), value.get("captured").asBoolean(),
    value.get("paid").asBoolean(), value.get("refunded").asBoolean(),
    value.get("disputed").asBoolean(), stripeExpandableId(value.get("customer")),
    stripeExpandableId(value.get("payment_intent")),
    stripeExpandableId(value.get("payment_method")),
    stripeExpandableId(value.get("balance_transaction")),
