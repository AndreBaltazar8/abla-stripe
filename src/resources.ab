class StripeInvoiceLine(
    val id: string,
    val amount: int,
    val subtotal: int,
    val currency: string,
    val description: string,
    val quantity: int,
    val priceId: string,
    val unitAmountDecimal: string,
    val periodStart: int,
    val periodEnd: int,
    val subscriptionId: string,
    val livemode: bool,
    val metadata: Json,
    val raw: Json
)

fun stripeInvoiceLine(value: Json): StripeInvoiceLine {
    val pricing = value.get("pricing")
    val period = value.get("period")
    return StripeInvoiceLine(
        value.getString("id"), value.getInt("amount"), value.getInt("subtotal"),
        value.getString("currency"), value.getString("description"),
        value.getInt("quantity"),
        stripeExpandableId(pricing.get("price_details").get("price")),
        pricing.getString("unit_amount_decimal"), period.getInt("start"),
        period.getInt("end"), stripeExpandableId(value.get("subscription")),
        value.get("livemode").asBoolean(),
        stripeJsonStringMap(value.get("metadata")), value
    )
}

class StripeInvoice(
    val id: string,
    val number: string,
    val status: string,
    val collectionMethod: string,
    val billingReason: string,
    val currency: string,
    val customerId: string,
    val customerName: string,
    val customerEmail: string,
    val subscriptionId: string,
    val subtotal: int,
    val total: int,
    val totalExcludingTax: int,
    val amountDue: int,
    val amountPaid: int,
    val amountRemaining: int,
    val dueDate: int,
    val periodStart: int,
    val periodEnd: int,
    val effectiveAt: int,
    val finalizedAt: int,
    val paidAt: int,
    val voidedAt: int,
    val hostedInvoiceUrl: string,
    val invoicePdf: string,
    val lines: array<StripeInvoiceLine>,
    // The invoice embeds only the first lines; invoiceLinesList reads the rest.
    val linesHasMore: bool,
    // Set on the answer to invoicesDelete.
    val deleted: bool,
    val created: int,
    val livemode: bool,
    val metadata: Json,
    val raw: Json
)

fun stripeInvoice(value: Json): StripeInvoice {
    val transitions = value.get("status_transitions")
    val lines: array<StripeInvoiceLine> = []
    val source = value.get("lines").get("data")
    var index = 0
    while (source.isArray() && index < source.size()) {
        lines.append(stripeInvoiceLine(source.at(index)))
        index = index + 1
    }
    return StripeInvoice(
        value.getString("id"), value.getString("number"), value.getString("status"),
        value.getString("collection_method"), value.getString("billing_reason"),
        value.getString("currency"), stripeExpandableId(value.get("customer")),
        value.getString("customer_name"), value.getString("customer_email"),
        stripeExpandableId(
            value.get("parent").get("subscription_details").get("subscription")
        ),
        value.getInt("subtotal"), value.getInt("total"),
        value.getInt("total_excluding_tax"), value.getInt("amount_due"),
        value.getInt("amount_paid"), value.getInt("amount_remaining"),
        value.getInt("due_date"), value.getInt("period_start"),
        value.getInt("period_end"), value.getInt("effective_at"),
        transitions.getInt("finalized_at"), transitions.getInt("paid_at"),
        transitions.getInt("voided_at"), value.getString("hosted_invoice_url"),
        value.getString("invoice_pdf"), lines,
        value.get("lines").get("has_more").asBoolean(),
        value.get("deleted").asBoolean(), value.getInt("created"),
        value.get("livemode").asBoolean(),
        stripeJsonStringMap(value.get("metadata")), value
    )
}

