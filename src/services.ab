class StripeCollectionResult(
    val succeeded: bool,
    val data: array<Json>,
    val hasMore: bool,
    val response: StripeResult
)

fun stripeEmptyResult(): StripeResult = stripeFailure(
    "configuration_error", "Stripe request was not made."
)

fun stripeEmptyCustomer(): StripeCustomer = stripeCustomer(jsonObject([], []))
fun stripeEmptyCheckoutSession(): StripeCheckoutSession =
    stripeCheckoutSession(jsonObject([], []))
fun stripeEmptyPortalSession(): StripeBillingPortalSession =
    stripeBillingPortalSession(jsonObject([], []))
fun stripeEmptySubscription(): StripeSubscription =
    stripeSubscription(jsonObject([], []))
fun stripeEmptyProduct(): StripeProduct = stripeProduct(jsonObject([], []))
fun stripeEmptyPrice(): StripePrice = stripePrice(jsonObject([], []))
fun stripeEmptyPaymentIntent(): StripePaymentIntent = stripePaymentIntent(jsonObject([], []))
fun stripeEmptyCharge(): StripeCharge = stripeCharge(jsonObject([], []))
fun stripeEmptyInvoice(): StripeInvoice = stripeInvoice(jsonObject([], []))
fun stripeEmptyRefund(): StripeRefund = stripeRefund(jsonObject([], []))
fun stripeEmptyDispute(): StripeDispute = stripeDispute(jsonObject([], []))
fun stripeEmptyBalanceTransaction(): StripeBalanceTransaction = stripeBalanceTransaction(jsonObject([], []))
fun stripeEmptyPayout(): StripePayout = stripePayout(jsonObject([], []))
fun stripeEmptyList(): StripeList = stripeList(jsonObject([], []))

fun stripeExpectedResponse(
    result: StripeResult,
    objectName: string,
    idPrefix: string
): StripeResult {
    if (!result.succeeded) return result
    val id = result.value.getString("id")
    val isList = objectName == "list"
    val valid = result.value.isObject() &&
        result.value.getString("object") == objectName &&
        ((isList && result.value.get("data").isArray() &&
          result.value.get("has_more").isBoolean() &&
          result.value.get("url").isString()) ||
         (!isList && id.size > idPrefix.size &&
          id.slice(0, idPrefix.size) == idPrefix))
    if (valid) return result
    StripeResult(
        false, result.value, result.body, result.status, result.requestId,
        result.apiVersion, result.idempotencyKey, result.retries,
        result.rateLimitedReason,
        StripeError(
            "parse_error", "Stripe response does not match the expected resource.",
            "", "", "", "", "", "", "", result.status,
            result.requestId, false, result.value
        )
    )
}

fun stripePaginationFailure(
    message: string,
    previous: StripeResult = stripeEmptyResult()
): StripeResult = StripeResult(
    false, previous.value, previous.body, previous.status, previous.requestId,
    previous.apiVersion, previous.idempotencyKey, previous.retries,
    previous.rateLimitedReason,
    StripeError(
        "pagination_error", message, "", "", "", "", "", "", "",
        previous.status, previous.requestId, false, previous.value
    )
)

fun StripeClient.collectList(
    path: string,
    params: StripeParams,
    maximumItems: int,
    options: StripeRequestOptions = stripeRequestOptions()
): StripeCollectionResult {
    val items: array<Json> = []
    if (maximumItems <= 0 || maximumItems > 10000 ||
        !stripePathValid(path) || params.has("starting_after") ||
        params.has("ending_before")) return StripeCollectionResult(
        false, items, false, stripePaginationFailure(
            "Pagination requires a valid path, a 1..10000 item bound and no caller cursor."
        )
    )
    var cursor = ""
    var previousCursor = ""
    var hasMore = true
    var last = stripeEmptyResult()
    while (hasMore && items.size < maximumItems) {
        val pageParams = params.copy()
        if (!pageParams.has("limit")) {
            val remaining = maximumItems - items.size
            pageParams.addInt("limit", if (remaining < 100) remaining else 100)
        }
        if (cursor != "") pageParams.add("starting_after", cursor)
        last = stripeExpectedResponse(
            this.rawRequest("GET", path, pageParams, options), "list", ""
        )
        if (!last.succeeded) return StripeCollectionResult(
            false, items, false, last
        )
        val page = stripeList(last.value)
        var index = 0
        while (index < page.data.size && items.size < maximumItems) {
            items.append(page.data[index])
            index = index + 1
        }
        hasMore = page.hasMore
        if (hasMore) {
            if (page.data.size == 0) return StripeCollectionResult(
                false, items, false, stripePaginationFailure(
                    "Stripe returned has_more with an empty page.", last
                )
            )
            previousCursor = cursor
            cursor = page.data[page.data.size - 1].getString("id")
            if (cursor == "" || cursor == previousCursor) return StripeCollectionResult(
                false, items, false, stripePaginationFailure(
                    "Stripe pagination cursor is missing or repeated.", last
                )
            )
        }
    }
    StripeCollectionResult(true, items, hasMore, last)
}

fun stripeResourcePath(prefix: string, id: string): string {
    var valid = id.size > 3
    var index = 0
    while (valid && index < id.size) {
        val byte = id[index]
        if (!stripeUnreserved(byte)) valid = false
        index = index + 1
    }
    if (valid) "$prefix/${stripePercentEncode(id)}" else ""
}

fun stripeResourceActionPath(prefix: string, id: string, action: string): string {
    val path = stripeResourcePath(prefix, id)
    if (path != "") "$path/$action" else ""
}

fun stripeMutationOptionsValid(options: StripeRequestOptions): bool =
    options.idempotencyKey != "" &&
    stripeIdempotencyKeyValid(options.idempotencyKey)

fun StripeClient.customersCreate(
    params: StripeParams,
    options: StripeRequestOptions
): StripeCustomerResult {
    if (!stripeMutationOptionsValid(options)) return StripeCustomerResult(
        false, stripeEmptyCustomer(), stripeFailure(
            "configuration_error", "Customer creation requires an idempotency key."
        )
    )
    val result = stripeExpectedResponse(
        this.rawRequest("POST", "/v1/customers", params, options),
        "customer", "cus_"
    )
    StripeCustomerResult(result.succeeded, stripeCustomer(result.value), result)
}

fun StripeClient.customersRetrieve(
    id: string,
    params: StripeParams = stripeParams(),
    options: StripeRequestOptions = stripeRequestOptions()
): StripeCustomerResult {
    val path = stripeResourcePath("/v1/customers", id)
    if (path == "") return StripeCustomerResult(
        false, stripeEmptyCustomer(), stripeFailure(
            "configuration_error", "Invalid Stripe Customer identifier."
        )
    )
    val result = stripeExpectedResponse(
        this.rawRequest("GET", path, params, options), "customer", "cus_"
    )
    StripeCustomerResult(result.succeeded, stripeCustomer(result.value), result)
}

fun StripeClient.customersUpdate(
    id: string,
    params: StripeParams,
    options: StripeRequestOptions
): StripeCustomerResult {
    val path = stripeResourcePath("/v1/customers", id)
    if (path == "" || !stripeMutationOptionsValid(options)) return StripeCustomerResult(
        false, stripeEmptyCustomer(), stripeFailure(
            "configuration_error", "Customer update requires a valid ID and idempotency key."
        )
    )
    val result = stripeExpectedResponse(
        this.rawRequest("POST", path, params, options), "customer", "cus_"
    )
    StripeCustomerResult(result.succeeded, stripeCustomer(result.value), result)
}

