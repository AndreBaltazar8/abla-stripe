import "../src/stripe.ab"

fun main: int {
    val port = stripeParseInt(stripeEnvironment("STRIPE_MOCK_PORT", "0"), 0)
    val config = StripeConfig(
        "sk_test_protocol_fixture", stripeDefaultApiVersion(), 3000, 0,
        1048576, false,
        StripeAppInfo("integration-test", "0.1.0", "https://example.test"),
        "127.0.0.1", port, true
    )
    val client = stripeLoopbackTestClient(config)
    val params = stripeParams()
    params.add("email", "andré@example.com")
    params.add("metadata[account_id]", "acc_123")
    val customer = client.customersCreate(
        params, stripeIdempotentRequest("fixture-customer-1")
    )
    val failed = client.rawRequest(
        "GET", "/v1/fail", stripeParams()
    )
    if (!customer.succeeded || customer.customer.id != "cus_fixture") 1
    else if (customer.response.requestId != "req_fixture_customer") 2
    else if (failed.succeeded || failed.status != 429) 3
    else if (failed.error.kind != "invalid_request_error") 4
    else if (failed.rateLimitedReason != "global-rate") 5
    else if (failed.requestId != "req_fixture_failure") 6
    else 0
}
